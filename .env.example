# Copy to .env for local development. All variables are optional.
# Docker Compose can run without a .env file.

CUTCLIPPER_ENVIRONMENT=development
CUTCLIPPER_LOG_LEVEL=INFO
CUTCLIPPER_LOG_JSON=true

# Whisper model: tiny, base, small, medium, large-v3, or a local model path.
# `base` is a good speed/quality tradeoff. The first run downloads the model.
CUTCLIPPER_WHISPER_MODEL=base
# Nepali default. The Caption studio can override this per request
# (fast=small beam 1, balanced=medium beam 5, best=large-v3 beam 5,
# maximum=large-v3 beam 10, with temperature fallback for accents).
CUTCLIPPER_NEPALI_WHISPER_MODEL=medium
# Optional comma-separated names/places to bias Nepali decoding.
# CUTCLIPPER_NEPALI_HOTWORDS=Kathmandu,Pokhara,सगरमाथा
CUTCLIPPER_WHISPER_DEVICE=auto
# auto | default | int8 | int8_float16 | float16 | float32
CUTCLIPPER_WHISPER_COMPUTE_TYPE=auto

# Optional Nepali -> English text translation for the Caption studio.
# Any OpenAI-compatible /chat/completions endpoint works (local servers too).
# Without it, the app falls back to Whisper's English pass and aligns the
# result to your subtitle timings.
# CUTCLIPPER_TRANSLATION_API_URL=http://127.0.0.1:11434/v1/chat/completions
# CUTCLIPPER_TRANSLATION_API_KEY=
# CUTCLIPPER_TRANSLATION_MODEL=gpt-4o-mini
# CUTCLIPPER_TRANSLATION_TIMEOUT_SECONDS=120

# auto picks VideoToolbox on macOS, NVENC when available, otherwise libx264.
CUTCLIPPER_VIDEO_ENCODER=auto

# Homebrew's regular ffmpeg formula lacks libass. ffmpeg-full is detected
# automatically at /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg, or set it here:
# CUTCLIPPER_FFMPEG_BINARY=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# CUTCLIPPER_FFPROBE_BINARY=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe

# Limits and retention
CUTCLIPPER_MAX_VIDEO_DURATION_SECONDS=7200
# Maximum accepted size for a local file upload (default 3 GB).
CUTCLIPPER_MAX_UPLOAD_BYTES=3000000000
CUTCLIPPER_JOB_TTL_SECONDS=21600
CUTCLIPPER_CLEANUP_INTERVAL_SECONDS=1800
CUTCLIPPER_MAX_CONCURRENT_JOBS=1

# Optional: authentication for age-restricted or sign-in-only videos.
# Use cookies from a browser profile on this machine (never uploaded):
# CUTCLIPPER_YTDLP_COOKIES_FROM_BROWSER=chrome
# Or point at a Netscape-format cookies.txt export:
# CUTCLIPPER_YTDLP_COOKIES_FILE=/absolute/path/to/cookies.txt
# You can also drop cookies.txt into backend/data/cookies.txt with no env var.

# Extra yt-dlp flags, for example proxy or extractor options.
# CUTCLIPPER_YTDLP_EXTRA_ARGS=--proxy http://127.0.0.1:8080
